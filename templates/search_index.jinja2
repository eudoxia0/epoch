{% extends "base.jinja2" %}

{% block content %}
    <div class="search-page">
        <form class="search-form" method="GET">
            <input type="text" name="q" value="{{ query }}" autofocus />
            <button class="button" type="Submit">
                <div class="icon">🔍</div>
                Search
            </button>
        </form>
        {% if !results.is_empty() %}
            <div class="results">
                {% for result in results %}
                    <div class="result">
                        <a href="{{ result.url }}">{{ result.display }}</a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <style>
        .search-page {
            padding: 24px 96px;

            .search-form {
                display: flex;
                flex-direction: row;
                gap: 12px;
                margin-bottom: 24px;

                input[type="text"] {
                    flex: 1;
                    font-family: "TeX Gyre Hermes";
                }
            }

            .results {
                display: flex;
                flex-direction: column;
                gap: 12px;

                .result {
                    border: 1px solid #ccc;
                    padding: 12px;
                    font-size: 24px;
                }
            }
        }
    </style>
{% endblock %}
