{% extends "base.jinja2" %}

{% block controls %}
    <div class="page-controls">
        <a class="button" href="{{ back_url }}">
            <div class="icon">🔙</div>
            Back
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="edit-entry-page">
        <form class="entry-form" method="POST">
            <textarea name="content" autofocus>{{ text }}</textarea>
            <button class="button">
                <div class="icon">💾</div>
                Save
            </button>
        </form>
    </div>
    <style>
        .edit-entry-page {
            height: 100%;
            padding: 24px 96px;
            display: flex;
            flex-direction: column;

            .entry-form {
                display: flex;
                flex-direction: column;
                flex: 1;
                gap: 12px;

                textarea {
                    flex: 1;
                }
            }
        }
    </style>
{% endblock %}
