{% extends "_base.jinja2" %}

{% block controls %}
    <div class="page-controls">
        <a class="button" href="{{ edit_url }}">
            <div class="icon">✏️</div>
            Edit
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="view-entry-page">
        <p>
            <i>{{ weekday }}</i>
        </p>
        {% if has_entry %}
            {{ content|safe }}
        {% else %}
            <p>
                <i>No entry for this date.</i>
            </p>
        {% endif %}
    </div>
    <style>
        .view-entry-page {
            padding: 24px 96px;
            font-size: 16px;
            height: 100%;
            text-align: justify;

            em {
                font-style: italic;
            }

            strong {
                font-weight: bold;
            }

            *:not(:last-child) {
                margin-bottom: 8px;
            }

            h1,
            h2,
            h3 {
                font-weight: bold;
            }

            h1 {
                font-size: 24px;
            }

            h2 {
                font-size: 18px;
            }

            li {
                margin-left: 48px;
                margin-right: 48px;
            }

            li:not(:last-child) {
                margin-bottom: 8px;
            }

            blockquote {
                padding-left: 16px;
                border-left: 2px solid #d5d5d5;
            }

            pre {
                border: 1px solid #d5d5d5;
                padding: 8px;
                background: #fafafa;
            }

            code {
                font-family: "TeX Gyre Cursor";
            }

            a {
                color: #b1002e;
            }

            table {
                border-collapse: collapse;
                width: 100%;

                th {
                    font-weight: bold;
                    text-align: center;
                }

                th,
                td {
                    padding: 4px 8px;
                    border: 1px solid black;
                }
            }
        }
    </style>
{% endblock %}
