{% extends "_base.jinja2" %}

{% block controls %}
    <div class="page-controls">
        <a class="button" href="{{ edit_url }}">
            <div class="icon">✏️</div>
            Edit
        </a>
        <a class="button" href="/achievements/new?date={{ date }}&return_url=/day/{{ date }}">
            <div class="icon">🏆</div>
            Log Achievement
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="view-entry-page">
        <p>
            <i>{{ weekday }}</i>
        </p>
        {% if has_entry %}
            <div class="rich-text">
                {{ content|safe }}
            </div>
        {% else %}
            <p>
                <i>No entry for this date.</i>
            </p>
        {% endif %}

        {% if !achievements.is_empty() %}
            <div class="achievements-section">
                <h2 class="achievements-header">Achievements</h2>
                <div class="achievements-list">
                    {% for achievement in achievements %}
                        <div class="achievement-item">
                            <div class="achievement-header">
                                <span class="achievement-icon">{{ achievement.achievement_type.icon() }}</span>
                                <span class="achievement-title">{{ achievement.achievement_type.title() }}</span>
                            </div>
                            <div class="achievement-content rich-text">
                                {{ achievement.content.as_html()?|safe }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
    <style>
        .view-entry-page {
            padding: 24px 96px;
            font-size: 16px;
            height: 100%;

            .achievements-section {
                margin-top: 48px;
                padding-top: 24px;
                border-top: 1px solid #e4e4e4;

                .achievements-header {
                    font-size: 20px;
                    font-weight: 600;
                    margin-bottom: 16px;
                    color: #000;
                }

                .achievements-list {
                    display: flex;
                    flex-direction: column;
                    gap: 16px;

                    .achievement-item {
                        padding: 16px;
                        border: 1px solid #e4e4e4;

                        .achievement-header {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            margin-bottom: 12px;

                            .achievement-icon {
                                font-size: 24px;
                            }

                            .achievement-title {
                                font-weight: 600;
                                color: #000;
                            }
                        }

                        .achievement-content {
                            color: #000;
                        }
                    }
                }
            }
        }
    </style>
{% endblock %}
