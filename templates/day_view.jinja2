{% extends "_base.jinja2" %}

{% block title_block %}
    <div class="title-with-nav">
        <a class="nav-link prev" href="{{ prev_url }}">«</a>
        <h1>{{ title }}</h1>
        <a class="nav-link next" href="{{ next_url }}">»</a>
    </div>
{% endblock %}

{% block controls %}
    <div class="page-controls">
        <a class="button" href="{{ edit_url }}">
            <div class="icon">✏️</div>
            Edit
        </a>
        <a class="button" href="/achievements/new?date={{ date }}&return_url=/day/{{ date }}">
            <div class="icon">🏆</div>
            Log Achievement
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="view-entry-page">
        <div class="main-area">
            <p>
                <i>{{ weekday }}</i>
            </p>
            {% if has_entry %}
                <div class="rich-text">
                    {{ content|safe }}
                </div>
            {% else %}
                <p>
                    <i>No entry for this date.</i>
                </p>
            {% endif %}
        </div>
        {% if !achievements.is_empty() %}
            <div class="achievements-section">
                <h2 class="achievements-header">Achievements</h2>
                <div class="achievements-list">
                    {% for achievement in achievements %}
                        <div class="achievement-item">
                            <div class="achievement-header">
                                <span class="achievement-icon">{{ achievement.achievement_type.icon() }}</span>
                                <span class="achievement-title">{{ achievement.achievement_type.title() }}</span>
                            </div>
                            <div class="achievement-content rich-text">
                                {{ achievement.content.as_html()?|safe }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
    <style>
        .title-with-nav {
            position: relative;
            display: inline-block;

            h1 {
                margin: 0;
                display: inline;
            }

            .nav-link {
                font-size: 36px;
                text-decoration: none;
                color: #666;
                transition: color 0.2s;
                position: absolute;
                top: 50%;
                transform: translateY(-50%);

                &:hover {
                    color: #000;
                }

                &.prev {
                    right: 100%;
                    margin-right: 12px;
                }

                &.next {
                    left: 100%;
                    margin-left: 12px;
                }
            }
        }

        .view-entry-page {
            font-size: 16px;

            .main-area {
                padding: 24px 96px;
                height: 100%;
            }

            .achievements-section {
                padding: 24px 96px;
                border-top: 1px solid #e4e4e4;

                .achievements-header {
                    font-size: 24px;
                    margin-bottom: 16px;
                }

                .achievements-list {
                    display: flex;
                    flex-direction: column;
                    gap: 16px;

                    .achievement-item {
                        padding: 16px;
                        border: 1px solid #e4e4e4;

                        .achievement-header {
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            margin-bottom: 12px;

                            .achievement-icon {
                                font-size: 24px;
                            }

                            .achievement-title {
                                font-weight: 600;
                                color: #000;
                            }
                        }

                        .achievement-content {
                            color: #000;
                        }
                    }
                }
            }
        }
    </style>
{% endblock %}
