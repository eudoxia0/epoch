{% extends "_base.jinja2" %}

{% block content %}
    <div class="all-entries-page">
        <div class="all-entries-body">
            {% for year in years %}
                <div class="calendar-year">
                    <h2 class="year-title">{{ year.year }}</h2>
                    <div class="months-grid">
                        {% for month in year.months %}
                            <div class="calendar-month">
                                <h3 class="month-title">{{ month.name }}</h3>
                                <div class="calendar-grid">
                                    <div class="calendar-header">Su</div>
                                    <div class="calendar-header">Mo</div>
                                    <div class="calendar-header">Tu</div>
                                    <div class="calendar-header">We</div>
                                    <div class="calendar-header">Th</div>
                                    <div class="calendar-header">Fr</div>
                                    <div class="calendar-header">Sa</div>

                                    {% for _ in 0..month.first_weekday %}
                                        <div class="calendar-day empty"></div>
                                    {% endfor %}

                                    {% for day in month.days %}
                                        <div class="calendar-day">
                                            <a href="{{ day.url }}"{% if !day.has_entry %} class="no-entry"{% endif %}>{{ day.day }}</a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <style>
        .all-entries-page {
            display: flex;
            flex-direction: column;
            flex: 1;

            overflow-y: scroll;

            .all-entries-header {
                padding: 24px 96px;
                border-bottom: 1px solid #e4e4e4;

                h1 {
                    font-size: 48px;
                }
            }

            .all-entries-body {
                padding: 24px;
                display: flex;
                flex-direction: column;
                gap: 48px;
            }
        }

        .calendar-year {
            .year-title {
                font-size: 32px;
                font-weight: bold;
                margin-bottom: 24px;
            }

            .months-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 24px;
            }
        }

        .calendar-month {
            .month-title {
                font-size: 18px;
                font-weight: bold;
                margin-bottom: 12px;
                text-align: center;
            }

            .calendar-grid {
                display: grid;
                grid-template-columns: repeat(7, 1fr);
                gap: 2px;
                font-size: 14px;
            }

            .calendar-header {
                text-align: center;
                font-weight: bold;
                padding: 4px;
                color: #666;
            }

            .calendar-day {
                text-align: center;
                padding: 4px;

                a {
                    display: block;
                    padding: 2px;
                    border-radius: 2px;
                    color: #b1002e;
                }

                a:hover {
                    background: #f0f0f0;
                }

                a.no-entry {
                    color: #ccc;
                }

                a.no-entry:hover {
                    background: #f8f8f8;
                }
            }
        }
    </style>
{% endblock %}
