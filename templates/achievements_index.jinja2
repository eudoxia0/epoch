{% extends "_base.jinja2" %}

{% block controls %}
    <div class="page-controls">
        <a class="button" href="/achievements/new">
            <div class="icon">➕</div>
            New Achievement
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="achievements-page">
        {% if achievements.is_empty() %}
            <p class="no-achievements">No achievements yet. Start logging your victories!</p>
        {% else %}
            <table class="achievements-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Content</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for achievement in achievements %}
                        <tr>
                            <td class="achievement-date">{{ achievement.date.humanize() }}</td>
                            <td>
                                <div class="achievement-type">
                                    <span class="achievement-icon">{{ achievement.achievement_type.icon() }}</span>
                                    <span class="achievement-title">{{ achievement.achievement_type.title() }}</span>
                                </div>
                            </td>
                            <td class="achievement-content rich-text">{{ achievement.content.as_html()?|safe }}</td>
                            <td>
                                <div class="achievement-actions">
                                    <a href="/achievements/{{ achievement.achievement_id }}/edit" class="edit-button">
                                        <div class="icon">✏️</div>
                                    </a>
                                    <form method="POST" action="/achievements/{{ achievement.achievement_id }}/delete" class="delete-form">
                                        <button type="submit" class="delete-button">
                                            <div class="icon">🗑️</div>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
    <style>
        .achievements-page {
            padding: 24px 96px;

            .no-achievements {
                text-align: center;
                color: #666;
                font-size: 18px;
                margin-top: 48px;
                font-style: italic;
            }

            .achievements-table {
                width: 100%;
                border-collapse: collapse;

                th, td {
                    border: 1px solid #ddd;
                    padding: 4px 8px;
                    vertical-align: center;
                }

                thead {
                    th {
                        text-align: center;
                        font-weight: bold;
                    }
                }

                tbody {
                    tr {
                        .achievement-type {
                            display: flex;
                            flex-direction: row;
                            gap: 8px;
                            justify-content: start;
                            align-items: center;

                            .achievement-icon {
                                font-size: 20px;
                            }

                            .achievement-title {
                                white-space: nowrap;
                            }
                        }

                        .achievement-date {
                            color: #666;
                            white-space: nowrap;
                        }

                        .achievement-actions {
                            display: flex;
                            flex-direction: row;
                            gap: 8px;
                            justify-content: start;

                            .edit-button {
                                background: white;
                                border: 1px solid #999;
                                cursor: pointer;
                                padding: 2px 6px;
                                text-decoration: none;

                                .icon {
                                    font-size: 16px;
                                }
                            }

                            .delete-form {
                                .delete-button {
                                    background: white;
                                    border: 1px solid #999;
                                    cursor: pointer;
                                    padding: 2px 6px;

                                    .icon {
                                        font-size: 16px;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    </style>
{% endblock %}
